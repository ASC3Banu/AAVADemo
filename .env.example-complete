# Application
NODE_ENV=development
PORT=8001
API_VERSION=v1

# Security
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRY=24h
ENCRYPTION_KEY=your-encryption-key-must-be-32-characters-long

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logistics_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/logistics_events

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=logistics-monitoring-system
KAFKA_CONSUMER_GROUP=logistics-events-group

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (seconds)
CACHE_TTL=300

# Compliance
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555

# External Services
AI_PREDICTION_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8006

# Logging
LOG_LEVEL=info