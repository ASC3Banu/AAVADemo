graph TB
    subgraph "Client Layer"
        WebApp["Web Application<br/>(React.js + TypeScript)<br/>Port: 3000"]
        MobileApp["Mobile App<br/>(React Native)<br/>iOS/Android"]
    end

    subgraph "API Gateway Layer"
        APIGateway["API Gateway<br/>(Kong/AWS API Gateway)<br/>Authentication, Rate Limiting<br/>Port: 8000"]
    end

    subgraph "Microservices Layer"
        TrackingService["Tracking Service<br/>(Node.js + Express)<br/>Shipment Management<br/>Port: 8001"]
        EventService["Event Processing Service<br/>(Java Spring Boot)<br/>Logistics Events<br/>Port: 8002"]
        AIService["AI Prediction Service<br/>(Python + TensorFlow)<br/>Delay Forecasting<br/>Port: 8003"]
        AlertService["Alert Service<br/>(Node.js + Express)<br/>Notification Management<br/>Port: 8004"]
        DashboardService["Dashboard Service<br/>(Node.js + Express)<br/>Analytics & Reporting<br/>Port: 8005"]
    end

    subgraph "Message Broker Layer"
        Kafka["Apache Kafka<br/>Event Streaming Platform<br/>Topics: shipments, events,<br/>predictions, alerts<br/>Port: 9092"]
    end

    subgraph "Data Layer"
        PostgreSQL[("PostgreSQL<br/>Primary Relational DB<br/>Shipments, Users, Alerts<br/>Port: 5432")]
        MongoDB[("MongoDB<br/>Document Store<br/>Logistics Events<br/>Port: 27017")]
        Redis[("Redis<br/>Cache & Session Store<br/>TTL-based Caching<br/>Port: 6379")]
    end

    subgraph "External Systems"
        PortSystems["Port Management<br/>Systems<br/>REST APIs"]
        WarehouseSystems["Warehouse<br/>Management Systems<br/>REST APIs"]
        TransportProviders["Transport Provider<br/>APIs<br/>REST/SOAP"]
        CustomsSystems["Customs Systems<br/>EDI/REST APIs"]
        NotificationServices["Notification Services<br/>(Email/SMS/Push)<br/>SendGrid, Twilio"]
    end

    subgraph "Infrastructure Layer"
        Kubernetes["Kubernetes Cluster<br/>Container Orchestration<br/>Multi-Region Deployment"]
        LoadBalancer["Load Balancer<br/>(AWS ALB/NLB)<br/>SSL Termination"]
        Monitoring["Monitoring Stack<br/>(Prometheus + Grafana)<br/>Metrics & Alerts"]
        Logging["Centralized Logging<br/>(ELK Stack)<br/>Log Aggregation"]
        Tracing["Distributed Tracing<br/>(Jaeger)<br/>Request Tracing"]
    end

